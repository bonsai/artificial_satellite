{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bonsai/artificial_satellite/blob/main/schemas/artificial_satellite.schema.json",
  "title": "Artificial Satellite",
  "description": "Canonical educational model for a satellite that can drive story, SVG, and Blender generators.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "id", "name", "purpose", "components"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "kind": { "type": "string", "const": "artificial_satellite" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "purpose": { "type": "string", "minLength": 1 },
    "archetype": { "type": "string", "description": "Optional reusable template identifier." },
    "specifications": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dimensions_m": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "x": { "type": "number", "exclusiveMinimum": 0 },
            "y": { "type": "number", "exclusiveMinimum": 0 },
            "z": { "type": "number", "exclusiveMinimum": 0 }
          },
          "required": ["x", "y", "z"]
        },
        "mass_kg": { "type": "number", "exclusiveMinimum": 0 },
        "orbit": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": { "type": "string" },
            "altitude_km": { "type": "number", "minimum": 0 },
            "inclination_deg": { "type": "number", "minimum": 0, "maximum": 180 }
          }
        }
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "name", "role"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
          "type": { "type": "string", "enum": ["body", "solar_panel", "antenna", "sensor", "thruster", "other"] },
          "name": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 },
          "dimensions_m": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "x": { "type": "number", "exclusiveMinimum": 0 },
              "y": { "type": "number", "exclusiveMinimum": 0 },
              "z": { "type": "number", "exclusiveMinimum": 0 }
            },
            "required": ["x", "y", "z"]
          },
          "material": { "type": "string" },
          "color": { "type": "string", "description": "CSS color or hex color for visual generators." },
          "mount": { "type": "string", "description": "Mount point or parent component id." }
        }
      }
    },
    "behaviors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "trigger", "action"],
        "properties": {
          "id": { "type": "string" },
          "trigger": { "type": "string" },
          "action": { "type": "string" },
          "result": { "type": "string" }
        }
      }
    },
    "story": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "premise": { "type": "string" },
        "audience": { "type": "string" },
        "learning_goals": { "type": "array", "items": { "type": "string" } }
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "units": { "type": "string", "enum": ["m", "cm", "mm"] },
        "origin": { "type": "string", "enum": ["center", "bottom", "custom"] },
        "camera": { "type": "string" }
      }
    },
    "outputs": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "enum": ["story", "svg", "blender"] }
    }
  }
}